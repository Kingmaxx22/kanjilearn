# Raw datasets. Download them yourself (see the "Datasets" section of README.md);
# tools/build-data.mjs only reads what is already here. Large, and reproducible.
cache/

# Generated bundles. Rebuild with `node tools/build-data.mjs`.
data/

# Installed agent skills and graphify output.
.agents/
.claude/
graphify-out/

# Desktop shell (Tauri). Rust build output and the staged copy of the web app
# are generated; the crate source itself is tracked.
#
# Cargo.lock is deliberately NOT ignored: this is an application, so the lock
# file is committed and the shipped binary is built from pinned dependencies.
src-tauri/target/
src-tauri/web/
# Only the capability schemas under src-tauri/gen are generated; the Android
# project next to them is source and is tracked (see ANDROID.md).
src-tauri/gen/schemas/

# Signing key for the Android APK, and the built APKs. The keystore has to
# survive between releases or Android will refuse to update the installed app,
# so keep it somewhere safe *outside* git -- see ANDROID.md.
.keys/
dist-android/

# Icon sources rendered by tools/app-icon.mjs.
build/
icon.ico
icon.png

# The icon set `cargo tauri icon` writes. The Windows bundle uses icon.ico and
# icon.png at the repo root (see tauri.conf.json), and Android uses the mipmaps
# committed under src-tauri/gen/android/app/src/main/res, so this copy is
# redundant for both.
src-tauri/icons/

node_modules/
.DS_Store
Thumbs.db
*.log