{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kanji Study",
  "version": "1.0.0",
  "identifier": "app.kanji.study",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kanji Study",
        "url": "index.html",
        "width": 1180,
        "height": 860,
        "minWidth": 480,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' data: blob:; object-src 'none'; base-uri 'self'; form-action 'none'",
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "../icon.ico",
      "../icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}